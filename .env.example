# Mealie: Profile > API Tokens
MEALIE_URL=http://192.168.0.83:3000
MEALIE_TOKEN=
# Where recipe links on the pages point (what your phones open)
MEALIE_PUBLIC_URL=https://mealie.example.com

# Home Assistant: Profile > Security > Long-lived access tokens
HA_URL=http://192.168.0.61:8123
HA_TOKEN=
HA_NOTIFY_TARGETS=mobile_app_your_phone,mobile_app_partner_phone

# Ollama on the Arc B580 (run once: ollama pull qwen3:8b)
OLLAMA_URL=http://192.168.0.83:11434
OLLAMA_MODEL=qwen3:8b

# Links in notifications (as reachable from your phones)
PUBLIC_URL=http://192.168.0.83:8790
VNC_URL=http://192.168.0.83:6080/vnc.html?autoconnect=1&resize=scale
# Password for the browser page. Leave empty and a random one is made and saved in /data/vnc-password.txt
VNC_PASSWORD=

# Set the same store and fulfillment method in the signed-in Walmart browser.
# You can also save these on the review page. Unknown local stock is excluded.
WALMART_STORE_ID=
WALMART_FULFILLMENT=PICKUP

# Weekly schedule (cron, local time)
REVIEW_CRON=0 17 * * sat
CART_CRON=45 8 * * sun
# Start with approval required. Set true to fill the cart without approval.
AUTO_CART_IF_UNREVIEWED=false

DEFAULT_SERVINGS=2
MEAL_ENTRY_TYPES=dinner
ORDER_MINIMUM=35
BROWSER_DELAY=4
TZ=America/New_York

# Default: send saved same-store products first, then check quantities and fulfillment in the cart.
CART_VERIFY_AFTER_ADD=true
# With CART_VERIFY_AFTER_ADD=false, reuse checks for up to 60 minutes. Set 0 for live checks.
CART_AVAILABILITY_MINUTES=60
